# Copy to an ignored file outside the asset bundle and pass it with
# --dart-define-from-file. Never add a real environment file to pubspec assets.
APP_ENV=development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_local_publishable_key

# Production release-only values. Do not use these for debug builds.
SUPABASE_URL_PROD=
SUPABASE_ANON_KEY_PROD=

# Optional crash reporting. Keep empty for local development unless testing Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
